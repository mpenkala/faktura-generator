{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.StaticFiles.StaticFileMiddleware": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Npgsql": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentUserName" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3} {RequestId} {UserId} {HttpRequestClientHostIP} {SourceContext,-56} {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": { "restrictedToMinimumLevel": "Warning" }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq.dev.xmarton.com:8008" }
      }
    ],
    "Properties": {
      "App": "app fagen",
      "Env": "Debug"
    }
  },
  "AllowedHosts": "*"
}
